# Copy to .env (gitignored) and fill in. Never commit .env.

# Which model writes summaries and views:
#   ollama:qwen3:14b   free, runs on this machine through Ollama (default)
#                      setup: `ollama serve` once, then `ollama pull qwen3:14b`
#   claude-opus-5-5    Claude through the Anthropic API: better, paid (needs a key below)
#   fake               canned answers, for trying the pipeline
RIB_MODEL=ollama:qwen3:14b

# Ollama: where it listens, and the context window to ask for (tokens)
RIB_OLLAMA_URL=http://localhost:11434
RIB_OLLAMA_CONTEXT=32768

# Requests sent at the same time
RIB_CONCURRENCY=4

# --- Only for Claude (paid) -------------------------------------------------
# Anthropic API key: https://platform.claude.com/ -> API keys
ANTHROPIC_API_KEY=
# low | medium | high | xhigh | max
RIB_EFFORT=medium
# on: estimate cost before each run and stop at the cap. off: no estimate, no cap
# (actual cost is still added up and shown). Local models are always free.
RIB_COST_CONTROL=on
# Spending cap per run, in US dollars (only used when RIB_COST_CONTROL=on)
RIB_SPEND_CAP_USD=1.0
