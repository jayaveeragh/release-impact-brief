# Copy to .env (gitignored) and fill in. Never commit .env.

# Anthropic API key: https://platform.claude.com/ -> API keys
ANTHROPIC_API_KEY=

# Model ID, or "fake" to run without the API (free, canned answers)
RIB_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max
RIB_EFFORT=medium
# on: estimate cost before each run and stop at the cap. off: no estimate, no cap
# (actual cost is still added up and shown).
RIB_COST_CONTROL=on
# Spending cap per run, in US dollars (only used when RIB_COST_CONTROL=on)
RIB_SPEND_CAP_USD=1.0
