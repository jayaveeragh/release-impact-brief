{
  "repo": "https://github.com/spring-petclinic/spring-petclinic-microservices",
  "commit_sha": "e8b747ab522721076cacb5cf688eb8a54ba8c5c9",
  "written": "2026-11-10, by reading the poms, application.yml files and @SpringBootApplication classes by hand, before the tool could classify",
  "structure": {
    "layout": "multi-module",
    "runtime": "microservices",
    "services": [
      {
        "name": "admin-server",
        "module": "spring-petclinic-admin-server",
        "main_class": "SpringBootAdminApplication",
        "roles": [
          "admin_server",
          "config_client",
          "discovery_client"
        ]
      },
      {
        "name": "api-gateway",
        "module": "spring-petclinic-api-gateway",
        "main_class": "ApiGatewayApplication",
        "roles": [
          "config_client",
          "discovery_client",
          "gateway"
        ]
      },
      {
        "name": "spring-petclinic-config-server",
        "module": "spring-petclinic-config-server",
        "main_class": "ConfigServerApplication",
        "roles": [
          "config_server"
        ]
      },
      {
        "name": "customers-service",
        "module": "spring-petclinic-customers-service",
        "main_class": "CustomersServiceApplication",
        "roles": [
          "config_client",
          "discovery_client"
        ]
      },
      {
        "name": "discovery-server",
        "module": "spring-petclinic-discovery-server",
        "main_class": "DiscoveryServerApplication",
        "roles": [
          "config_client",
          "discovery_server"
        ]
      },
      {
        "name": "genai-service",
        "module": "spring-petclinic-genai-service",
        "main_class": "GenAIServiceApplication",
        "roles": [
          "config_client",
          "discovery_client"
        ]
      },
      {
        "name": "vets-service",
        "module": "spring-petclinic-vets-service",
        "main_class": "VetsServiceApplication",
        "roles": [
          "config_client",
          "discovery_client"
        ]
      },
      {
        "name": "visits-service",
        "module": "spring-petclinic-visits-service",
        "main_class": "VisitsServiceApplication",
        "roles": [
          "config_client",
          "discovery_client"
        ]
      }
    ]
  },
  "connections": {
    "written": "2026-11-11, by reading the Java clients, gateway routes, poms and application*.yml by hand, before the tool could detect connections",
    "routes": [
      [
        "api-gateway",
        "customers-service",
        "exact"
      ],
      [
        "api-gateway",
        "vets-service",
        "exact"
      ],
      [
        "api-gateway",
        "visits-service",
        "exact"
      ],
      [
        "api-gateway",
        "genai-service",
        "exact"
      ]
    ],
    "requests": [
      [
        "api-gateway",
        "customers-service",
        "likely"
      ],
      [
        "api-gateway",
        "visits-service",
        "likely"
      ],
      [
        "genai-service",
        "vets-service",
        "likely"
      ],
      [
        "genai-service",
        "customers-service",
        "likely"
      ]
    ],
    "uses": [
      [
        "customers-service",
        "hsqldb",
        "likely"
      ],
      [
        "customers-service",
        "mysql",
        "likely"
      ],
      [
        "vets-service",
        "hsqldb",
        "likely"
      ],
      [
        "vets-service",
        "mysql",
        "likely"
      ],
      [
        "visits-service",
        "hsqldb",
        "likely"
      ],
      [
        "visits-service",
        "mysql",
        "likely"
      ],
      [
        "genai-service",
        "hsqldb",
        "likely"
      ],
      [
        "genai-service",
        "mysql",
        "likely"
      ]
    ],
    "uses_note": "datasource URLs live in the external config repo, so only the JDBC drivers on the classpath are visible",
    "messaging": []
  }
}
